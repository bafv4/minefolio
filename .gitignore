# Claude Code のエージェント作業用 worktree（コミットすると submodule 扱いになり
# Vercel クローン時に "Failed to fetch git submodules" 警告が出る）
/.claude/worktrees/

# Claude Code のローカル専用設定（個人の許可ルール・ローカルパスを含むため共有しない）
/.claude/settings.local.json

# ビルドログ等の一時ファイル
/log.txt


# graphify（ナレッジグラフ）: 共有するのは graph.json / GRAPH_REPORT.md / graph.html / .graphify_labels.json のみ。
# キャッシュ・マニフェスト・コスト記録・ローカル絶対パスを含むメタファイルは各環境で生成する
/graphify-out/cache/
/graphify-out/manifest.json
/graphify-out/cost.json
/graphify-out/memory/
/graphify-out/reflections/
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
/graphify-out/.graphify_*
!/graphify-out/.graphify_labels.json
