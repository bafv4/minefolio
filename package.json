  "scripts": {
    "dev": "react-router dev",
    "dev:remote": "react-router dev --mode remote",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "gen:test-schema": "drizzle-kit export --dialect=sqlite --schema=./app/lib/schema.ts > app/lib/__tests__/helpers/test-schema.sql",
